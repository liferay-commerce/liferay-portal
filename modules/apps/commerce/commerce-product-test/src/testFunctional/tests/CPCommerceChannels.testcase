@component-name = "portal-commerce"
definition {

	property browser.chrome.version = "139.0";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Product Info Management";

	setUp {
		CommerceConfiguration.commerceSetUp(minium = "true");

		task ("Enable private pages") {
			PagesAdmin.enablePrivatePages();
		}
	}

	tearDown {
		CommerceConfiguration.commerceTearDown();
	}

	@description = "Verify all shipping options are available when orders are made using different order types given shipping option eligibility is set to All Order Types."
	@priority = 5
	test ShippingOptionEligibleForAnyOrderType {
		property custom.properties = "company.security.strangers.verify=false${line.separator}jsonws.web.service.paths.excludes=";
		property portal.acceptance = "true";

		task ("Given an account with a buyer user") {
			CommerceEntry.addAccountEntryUser(
				accountName = "Commerce Account",
				accountType = "Business",
				agreeToTermsAndAnswerReminderQuery = "true",
				createNewAccount = "true",
				requireReset = "false",
				userEmailAddress = "buyer@liferay.com",
				userFirstName = "Buyer",
				userLastName = "User",
				userRole = "Buyer",
				userScreenName = "buyeruser",
				userSiteMembership = "Minium");
		}

		task ("And given two active order types") {
			CommerceJSONOrdersAPI._addOrderType(
				active = "true",
				orderTypeDescription = "Test Order Type Description 1",
				orderTypeName = "Test Order Type 1");

			CommerceJSONOrdersAPI._addOrderType(
				active = "true",
				orderTypeDescription = "Test Order Type Description 2",
				orderTypeName = "Test Order Type 2");
		}

		task ("And given the buyer creates an order for each order type") {
			User.logoutPG();

			CommerceLogin.miniumLogin(
				password = PropsUtil.get("default.admin.password"),
				urlAppend = "web/minium",
				userEmailAddress = "buyer@liferay.com");

			CommerceAcceleratorsInitializer.createNewOrderFromPendingOrders(orderType = "Test Order Type 1");

			WaitForElementPresent(locator1 = "CommerceEntry#ACTIVE_ORDER_ID");

			var order1Id = selenium.getText("CommerceEntry#ACTIVE_ORDER_ID");

			CommerceAcceleratorsInitializer.createNewOrderFromPendingOrders(orderType = "Test Order Type 2");

			WaitForElementPresent(locator1 = "CommerceEntry#ACTIVE_ORDER_ID");

			var order2Id = selenium.getText("CommerceEntry#ACTIVE_ORDER_ID");
		}

		task ("When the user goes to checkout for the Test Order Type 2 order") {
			CommerceNavigator.gotoMiniumSidebarItem(menuItem = "Catalog");

			FrontStore.addInitializerProductToCart(
				productName = "U-Joint",
				productQuantity = 1);

			CommerceOrders.selectOrderFromAccountSelector(orderId = ${order2Id});

			Button.click(button = "Checkout");
		}

		task ("Then at the shipping method step, all active Shipping options should be available") {
			CommerceCheckout.initializersCheckout(
				newAddressAddress = "Test Address",
				newAddressCity = "Test City",
				newAddressCountry = "United States",
				newAddressName = "Address Name",
				newAddressZipCode = "Test Zip Code");

			AssertElementPresent(
				key_radioOption = "Standard",
				locator1 = "CommerceEntry#RADIO_BUTTON");

			AssertElementPresent(
				key_radioOption = "Expedited",
				locator1 = "CommerceEntry#RADIO_BUTTON");
		}

		task ("When the user goes to checkout for the Test Order Type 1 order") {
			CommerceNavigator.gotoMiniumSidebarItem(menuItem = "Catalog");

			CommerceOrders.selectOrderFromAccountSelector(orderId = ${order1Id});

			CommerceNavigator.gotoMiniumSidebarItem(menuItem = "Catalog");

			FrontStore.addInitializerProductToCart(
				productName = "U-Joint",
				productQuantity = 1);

			CommerceOrders.selectOrderFromAccountSelector(orderId = ${order1Id});

			Button.click(button = "Checkout");
		}

		task ("Then at the shipping method step, all active Shipping options should be available") {
			CommerceCheckout.initializersCheckout(
				newAddressAddress = "Test Address",
				newAddressCity = "Test City",
				newAddressCountry = "United States",
				newAddressName = "Address Name",
				newAddressZipCode = "Test Zip Code");

			AssertElementPresent(
				key_radioOption = "Standard",
				locator1 = "CommerceEntry#RADIO_BUTTON");

			AssertElementPresent(
				key_radioOption = "Expedited",
				locator1 = "CommerceEntry#RADIO_BUTTON");
		}
	}

	@description = "Verify users can configure shipping option eligibility to specific order types."
	@priority = 5
	test ShippingOptionEligibleForSpecificOrderType {
		property custom.properties = "company.security.strangers.verify=false${line.separator}jsonws.web.service.paths.excludes=";
		property portal.acceptance = "true";

		task ("Given an account with a buyer user") {
			CommerceEntry.addAccountEntryUser(
				accountName = "Commerce Account",
				accountType = "Business",
				agreeToTermsAndAnswerReminderQuery = "true",
				createNewAccount = "true",
				requireReset = "false",
				userEmailAddress = "buyer@liferay.com",
				userFirstName = "Buyer",
				userLastName = "User",
				userRole = "Buyer",
				userScreenName = "buyeruser",
				userSiteMembership = "Minium");
		}

		task ("And given two active order types") {
			CommerceJSONOrdersAPI._addOrderType(
				active = "true",
				orderTypeDescription = "Test Order Type Description 1",
				orderTypeName = "Test Order Type 1");

			CommerceJSONOrdersAPI._addOrderType(
				active = "true",
				orderTypeDescription = "Test Order Type Description 2",
				orderTypeName = "Test Order Type 2");
		}

		task ("And given an active shipping option's eligibility is set specifically to Test Order Type 1") {
			CommerceChannels.openChannelsAdmin();

			CommerceNavigator.gotoEntry(entryName = "Minium Portal");

			CommerceEntry.setEntryEligibility(
				orderTypesEligibility = "Test Order Type 1",
				shippingMethod = "Flat Rate",
				shippingOption = "Standard Delivery");
		}

		task ("And given the buyer creates an order for each order type") {
			User.logoutPG();

			CommerceLogin.miniumLogin(
				password = PropsUtil.get("default.admin.password"),
				urlAppend = "web/minium",
				userEmailAddress = "buyer@liferay.com");

			CommerceAcceleratorsInitializer.createNewOrderFromPendingOrders(orderType = "Test Order Type 1");

			WaitForElementPresent(locator1 = "CommerceEntry#ACTIVE_ORDER_ID");

			var order1Id = selenium.getText("CommerceEntry#ACTIVE_ORDER_ID");

			CommerceAcceleratorsInitializer.createNewOrderFromPendingOrders(orderType = "Test Order Type 2");

			WaitForElementPresent(locator1 = "CommerceEntry#ACTIVE_ORDER_ID");

			var order2Id = selenium.getText("CommerceEntry#ACTIVE_ORDER_ID");
		}

		task ("When the user goes to checkout for the Test Order Type 2 order") {
			CommerceNavigator.gotoMiniumSidebarItem(menuItem = "Catalog");

			FrontStore.addInitializerProductToCart(
				productName = "U-Joint",
				productQuantity = 1);

			CommerceOrders.selectOrderFromAccountSelector(orderId = ${order2Id});

			Button.click(button = "Checkout");
		}

		task ("Then at the shipping method step, the edited shipping option should not be available") {
			CommerceCheckout.initializersCheckout(
				newAddressAddress = "Test Address",
				newAddressCity = "Test City",
				newAddressCountry = "United States",
				newAddressName = "Address Name",
				newAddressZipCode = "Test Zip Code",
				shippingOption = "Expedited");
		}

		task ("When the user goes to checkout for the Test Order Type 1 order") {
			CommerceNavigator.gotoMiniumSidebarItem(menuItem = "Catalog");

			CommerceOrders.selectOrderFromAccountSelector(orderId = ${order1Id});

			CommerceNavigator.gotoMiniumSidebarItem(menuItem = "Catalog");

			FrontStore.addInitializerProductToCart(
				productName = "U-Joint",
				productQuantity = 1);

			CommerceOrders.selectOrderFromAccountSelector(orderId = ${order1Id});

			Button.click(button = "Checkout");
		}

		task ("Then at the shipping method step, the edited shipping option should be available") {
			CommerceCheckout.initializersCheckout(
				newAddressAddress = "Test Address",
				newAddressCity = "Test City",
				newAddressCountry = "United States",
				newAddressName = "Address Name",
				newAddressZipCode = "Test Zip Code");

			AssertElementPresent(
				key_radioOption = "Standard",
				locator1 = "CommerceEntry#RADIO_BUTTON");

			AssertElementPresent(
				key_radioOption = "Expedited",
				locator1 = "CommerceEntry#RADIO_BUTTON");
		}
	}

	@description = "This is a test for COMMERCE-8300. The store admin can upload a custom jasper print template"
	@priority = 5
	test UploadCustomJasperPrintTemplate {
		property portal.acceptance = "true";

		task ("When the sales channel detail page is reached") {
			CommerceChannels.openChannelsAdmin();
		}

		task ("And the "Select File" in the Orders box is clicked and the jasper template is chosen for being uploaded") {
			CommerceNavigator.gotoEntry(entryName = "Minium Portal");

			CommerceChannels.uploadPrintOrderTemplate(uploadFileName = "commerce_order.jrxml");

			CommerceChannels.openChannelsAdmin();
		}

		task ("Then the file name is shown next to the "Select File" button") {
			CommerceNavigator.gotoEntry(entryName = "Minium Portal");

			AssertTextEquals(
				locator1 = "CommerceOrders#PRINT_ORDER_TEMPLATE_FILE_NAME",
				value1 = "commerce_order.jrxml");
		}
	}

	@description = "This is a test for COMMERCE-8300. The store admin can view and download the jasper template"
	@priority = 3
	test ViewAndDownloadCustomJasperPrintTemplate {
		property portal.acceptance = "false";

		task ("When the sales channel detail page is reached") {
			CommerceChannels.openChannelsAdmin();
		}

		task ("And the "Select File" in the Orders box is clicked, the jasper template is chosen for being uploaded, the file name is clicked, and the preview template is shown") {
			CommerceNavigator.gotoEntry(entryName = "Minium Portal");

			CommerceChannels.uploadPrintOrderTemplate(uploadFileName = "commerce_order.jrxml");
		}

		task ("Then the jasper template is chosen for being uploaded, the file name is clicked, and the preview template is shown, and the store admin can download the template") {
			AssertTextEquals(
				locator1 = "CommerceOrders#PRINT_ORDER_TEMPLATE_FILE_NAME",
				value1 = "commerce_order.jrxml");
		}
	}

	@description = "This is a test for COMMERCE-8300. The buyer can view the order preview with the uploaded template"
	@priority = 5
	test ViewOrderPreviewWithJasperTemplate {
		property custom.properties = "company.security.strangers.verify=false${line.separator}jsonws.web.service.paths.excludes=";
		property portal.acceptance = "true";

		task ("Given a channel with a Print Order Template jasper file ") {
			CommerceChannels.openChannelsAdmin();

			CommerceNavigator.gotoEntry(entryName = "Minium Portal");

			CommerceChannels.uploadPrintOrderTemplate(uploadFileName = "commerce_order.jrxml");
		}

		task ("And a buyer user is logged in") {
			CommerceEntry.addAccountEntryUser(
				accountName = "Commerce Account",
				accountType = "Business",
				agreeToTermsAndAnswerReminderQuery = "true",
				createNewAccount = "true",
				requireReset = "false",
				userEmailAddress = "buyer@liferay.com",
				userFirstName = "Buyer",
				userLastName = "User",
				userRole = "Buyer",
				userScreenName = "buyeruser",
				userSiteMembership = "Minium");

			User.logoutPG();
		}

		task ("When an order is placed") {
			CommerceLogin.miniumLogin(
				password = PropsUtil.get("default.admin.password"),
				urlAppend = "web/minium",
				userEmailAddress = "buyer@liferay.com");

			FrontStore.addInitializerProductToCart(
				productName = "U-Joint",
				productQuantity = 1);

			CommerceCheckout.gotoCheckout();

			CommerceCheckout.checkout(
				newAddressAddress = "Test Address",
				newAddressCity = "Test City",
				newAddressCountry = "United States",
				newAddressName = "Address Name",
				newAddressZipCode = "Test Zip Code",
				shippingMethod = "Standard");

			Navigator.openWithAppendToBaseURL(urlAppend = "web/minium/placed-orders");
		}

		task ("Then the buyer user should be able to view and print the order") {
			CommerceOrders.viewJasperTemplateFromPlacedOrders();
		}
	}

}
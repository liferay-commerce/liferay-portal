Bundle-Name: Liferay Dispatch Web
Bundle-SymbolicName: com.liferay.dispatch.web
Bundle-Version: 2.0.0
Provide-Capability:\
	liferay.resource.bundle;\
		resource.bundle.aggregate:String="(bundle.symbolic.name=com.liferay.dispatch.lang)";\
		resource.bundle.base.name="content.Language"
Web-ContextPath: /dispatch-web